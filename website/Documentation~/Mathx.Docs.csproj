<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Mathematics.Mathx</AssemblyName>
    <RootNamespace>Unity.Mathematics</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591;CS0436;CS0618;CS8981;CS0108;CS0114</NoWarn>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../package/Runtime/**/*.cs" Exclude="../../package/Runtime/_Experimental/**" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Unity.Collections.LowLevel.Unsafe" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Stubs/Unity.Stubs.csproj" />
    <PackageReference Include="UnityMathematics.NoDeps" Version="1.3.2" />
  </ItemGroup>
</Project>
